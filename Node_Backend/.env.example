# Copy this file to ".env" and fill in the real values.
# Nothing in this specific file is a secret (URLs and a port number only) -
# the actual credential needed to run the server locally is the separate
# Firebase service-account key (see src/config/serviceAccountKey.example.json).

# Server Configuration
PORT=8080

# The URL of our Python AI Server
AI_SERVER_URL=https://<your-ai-engine-cloud-run-url>.run.app
#AI_SERVER_URL=http://127.0.0.1:5000

# Firebase Realtime Database URL (find this in Firebase Console > Realtime Database)
FIREBASE_DB_URL=https://<your-project-id>-default-rtdb.firebaseio.com/
